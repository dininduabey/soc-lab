# {{ ansible_managed }}
global:
  scrape_interval: 30s
  evaluation_interval: 30s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  - job_name: node
    static_configs:
      - targets: ['{{ monitoring_victim_ip }}:9100']
        labels: {host: web-victim}

  - job_name: nginx
    static_configs:
      - targets: ['{{ monitoring_victim_ip }}:9113']
        labels: {host: web-victim}
